<?xml version="1.0" encoding="utf-8"?>
<!--
  Navisworks plugin manifest.

  Navisworks scans %APPDATA%\Autodesk\Navisworks Manage 20XX\Plugins\
  on startup and loads any subfolder containing a .addin file plus its
  matching DLL.  This file tells Navisworks WHERE to look and what
  ribbon button to draw.

  Layout on disk after install:

    %APPDATA%\Autodesk\Navisworks Manage 2026\Plugins\MCPBridge\
        |- MCPBridge.addin              (this file)
        |- NavisworksMcpAddin.dll       (compiled assembly)
-->
<RibbonInfo>
  <Plugins>
    <Plugin Name="MCPBridge"
            DisplayName="MCP Bridge"
            Developer="ADSK"
            ToolTip="HTTP bridge for the Model Context Protocol server"
            LoadOnStartup="True">
      <Assembly>NavisworksMcpAddin.dll</Assembly>
    </Plugin>
  </Plugins>
</RibbonInfo>
